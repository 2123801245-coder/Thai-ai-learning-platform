# ============================================================
# ThaiAI 部署配置模板
# 复制为 deploy.env（已被 .gitignore 忽略，不会入库）后填写：
#   cp deploy/deploy.env.example deploy/deploy.env
# ============================================================

# 服务器地址（必填）
DEPLOY_SERVER=8.140.225.225

# SSH 用户
DEPLOY_USER=root

# 服务器上 dist 的绝对路径
DEPLOY_REMOTE_DIST=/opt/thaiai/dist

# 站点 URL（用于部署后验证）
DEPLOY_SITE_URL=https://thai-ai.online

# 服务器 SSH 密码（也可在命令行 export SSHPASS=xxx 传入，优先用环境变量）
# ⚠️ 建议不要把密码写在这个文件里，而是每次部署时：
#   export SSHPASS='你的密码' && ./deploy/deploy.sh
# SSHPASS=
