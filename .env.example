# ============================================================
# ThaiAI 生产环境变量模板
# 复制为 .env 并逐项填写（.env 已被 .gitignore 忽略，不会入库）
# ============================================================

# ---------- 安全 ----------
# 登录令牌签名密钥（务必改成 32+ 位随机串：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string
# 管理员邮箱（逗号分隔，注册即自动成为管理员）
ADMIN_EMAILS=admin@example.com

# ---------- 在线支付：微信支付官方 Native（推荐，小微商户个人可申请）----------
# 微信支付商户平台（pay.weixin.qq.com）→ 小微商户申请（身份证+银行卡）
# 商户后台 → API 安全 → 设置 APIv3 密钥、下载 apiclient_key.pem / apiclient_cert.pem
PAY_WECHAT_MCHID=
# API v3 密钥（32 位，商户平台设置）
PAY_WECHAT_APIV3_KEY=
# 商户 API 证书序列号（apiclient_cert.pem 的序列号，商户平台「API安全」页可见）
PAY_WECHAT_SERIAL_NO=
# 商户 API 私钥（apiclient_key.pem 文件内容，可填路径或整段 PEM）
PAY_WECHAT_PRIVATE_KEY=
# 微信支付平台证书 PEM（可选；不填则后端首次回调时自动从 /v3/certificates 下载）
PAY_WECHAT_PLATFORM_CERT=
# 可选；小微商户 Native 扫码一般无需 appid
PAY_WECHAT_APPID=
# ⚠️ 仅本地开发演示用：PAY_WECHAT_MOCK=1 时假装微信已配置并返回演示二维码（不真正扣款）
#    生产环境【必须删除或置空】，否则支付界面可用但永远收不到钱！
PAY_WECHAT_MOCK=

# ---------- 在线支付：易支付聚合（支付宝补充渠道）----------
# 商户号（pid）——在任意「易支付/彩虹易支付」系统注册即得
PAY_EPAY_MCHID=
# 商户密钥（MD5 签名）
PAY_EPAY_KEY=
# 支付网关地址，如 https://pay.example.com
PAY_EPAY_GATEWAY=
# 你的站点域名（回调送达地址），必须 https 且能被公网访问
# 例：https://your-domain.com
# 微信官方回调地址为：{PAY_NOTIFY_BASE}/api/payments/wechat-notify
PAY_NOTIFY_BASE=https://your-domain.com

# ---------- 在线支付：Stripe 兜底（可选）----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- 语音评测（Azure Speech 发音评估）----------
SPEECH_KEY=
SPEECH_REGION=eastasia

# ---------- AI 服务（AI 老师对话 / 出题 / 讲解 / 新闻翻译 共用同一个出口）----------
# 选哪个提供方：auto（默认，按可用 key 自动挑）| deepseek | agnes
AI_PROVIDER=auto

# 提供方 1：DeepSeek（默认）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 提供方 2：Agnes 网关（OpenAI 兼容，可选替代）
# 想切过去就把 key 填上，并设 AI_PROVIDER=agnes；AGNES_API_KEY 是规范名，
# AI_API_KEY 为历史别名（两者等价，填哪个都认）。
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# 说明：
#   - 占位符 key（如「你的xxxKEY」）会被自动识别为「未配置」，直接 503 而不是等上游 401。
#   - .env 的加载不再依赖启动目录：优先 backend/.env，其次仓库根 .env（见 backend/env.js）。
#   - 自检：GET /api/ai/status（?probe=1 会真实发一次极小的上游请求）

# ---------- 部署 ----------
# 前端域名（CORS 白名单，逗号分隔）
CORS_ORIGINS=https://your-domain.com

# ---------- 可选 ----------
# 初始激活码（CODE:天数,CODE:天数）
VIP_CODES=
# 套餐价格（元）
VIP_PLAN_30_CNY=49
VIP_PLAN_90_CNY=128
VIP_PLAN_365_CNY=399

# ---------- 新闻翻译（DeepSeek，可选）----------
# 为 ThaiPBS 每日新闻生成中文译文 + 罗马音注音。
DEEPSEEK_API_KEY=
